<Window x:Class="BookFlow.App.Views.GridSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOM Grid Settings" Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#FF2B3E50">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Columns">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Settings.Columns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Padding="10" BorderBrush="#FF4A90E2" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Column name -->
                                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left">
                                            <TextBlock Foreground="#FF95A5A6" Text="Column"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" Margin="0,6,0,0"/>
                                        </StackPanel>

                                        <!-- Width -->
                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left">
                                            <TextBlock Foreground="#FF95A5A6" Text="Width"/>
                                            <TextBox Width="100" Margin="0,6,0,0"
                                                     Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <!-- Font Size -->
                                        <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Left">
                                            <TextBlock Foreground="#FF95A5A6" Text="Font Size"/>
                                            <TextBox Width="100" Margin="0,6,0,0"
                                                     Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <!-- Bold -->
                                        <StackPanel Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Left">
                                            <TextBlock Foreground="#FF95A5A6" Text="Bold"/>
                                            <CheckBox Margin="0,8,0,0" IsChecked="{Binding IsBold}"/>
                                        </StackPanel>

                                        <!-- Font Color (palette) -->
                                        <StackPanel Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Left">
                                            <TextBlock Foreground="#FF95A5A6" Text="Font Color"/>
                                            <ComboBox Width="130" Margin="0,6,0,0" SelectedValuePath="Tag"
                                                      SelectedValue="{Binding FontColor, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="White" Tag="#FFFFFFFF"/>
                                                <ComboBoxItem Content="Blue" Tag="#FF3498DB"/>
                                                <ComboBoxItem Content="Green" Tag="#FF4CAF50"/>
                                                <ComboBoxItem Content="Red" Tag="#FFE74C3C"/>
                                                <ComboBoxItem Content="Orange" Tag="#FFFF9800"/>
                                                <ComboBoxItem Content="Cyan" Tag="#FF00BCD4"/>
                                                <ComboBoxItem Content="Magenta" Tag="#FFE91E63"/>
                                                <ComboBoxItem Content="Gray" Tag="#FF95A5A6"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="90" Height="28" Margin="0,0,6,0" Content="Reset" Click="Reset_Click"/>
            <Button Width="90" Height="28" Margin="0,0,6,0" Content="Apply" Click="Apply_Click"/>
            <Button Width="90" Height="28" Content="Close" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>