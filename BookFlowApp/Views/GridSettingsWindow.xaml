<Window x:Class="BookFlow.App.Views.GridSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOM Settings" Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E2A3A">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#FF2B3E50"/>
        <SolidColorBrush x:Key="PanelDeep" Color="#FF1A252F"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4A90E2"/>
        <SolidColorBrush x:Key="Muted" Color="#FF95A5A6"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelDeep}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Dark tab headers -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}"
                                BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Margin="0,0,2,0" Padding="14,6">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="White" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="#FF5BA0F2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF5BA0F2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1">

            <!-- ===================== COLUMNS ===================== -->
            <TabItem Header="Columns">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table header -->
                    <Grid Grid.Row="0" Margin="6,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColHeader}" Text="COLUMN"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ColHeader}" Text="WIDTH"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource ColHeader}" Text="FONT SIZE"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource ColHeader}" Text="BOLD"/>
                        <TextBlock Grid.Column="4" Style="{StaticResource ColHeader}" Text="FONT COLOR"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Settings.Columns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="6,4" Background="{StaticResource PanelDeep}" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBox   Grid.Column="1" Width="70" HorizontalAlignment="Left" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox   Grid.Column="2" Width="70" HorizontalAlignment="Left" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>
                                            <CheckBox  Grid.Column="3" IsChecked="{Binding IsBold}"/>
                                            <ComboBox  Grid.Column="4" Width="140" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                                       SelectedValue="{Binding FontColor, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBoxItem Content="White" Tag="#FFFFFFFF"/>
                                                <ComboBoxItem Content="Blue" Tag="#FF3498DB"/>
                                                <ComboBoxItem Content="Green" Tag="#FF4CAF50"/>
                                                <ComboBoxItem Content="Red" Tag="#FFE74C3C"/>
                                                <ComboBoxItem Content="Orange" Tag="#FFFF9800"/>
                                                <ComboBoxItem Content="Cyan" Tag="#FF00BCD4"/>
                                                <ComboBoxItem Content="Magenta" Tag="#FFE91E63"/>
                                                <ComboBoxItem Content="Gray" Tag="#FF95A5A6"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================== SIGNALS ===================== -->
            <TabItem Header="Order-Flow Signals">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,10">
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,2" Text="Order-Flow Detection (this instrument)"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Volume thresholds scale with contract size — tune per instrument (ES carries far more size than a thin future). Changes apply live."/>

                        <CheckBox Content="Enable order-flow signals" Margin="0,4,0,2"
                                  IsChecked="{Binding Settings.EnableMicrostructureSignals}"/>
                        <CheckBox Content="Auto-hide types whose reliability stays red" Margin="0,2,0,2"
                                  IsChecked="{Binding Settings.AutoHideUnreliableSignals}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Auto-hide mutes a type with a consistently red hit-rate (enough resolved samples) even if its 'Show in feed' box below is checked. Detection and scoring keep running either way."/>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Reliability scoring (definition of &quot;success&quot;)"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A signal is scored a WIN if price reaches +Target ticks before -Stop ticks (asymmetric allowed, e.g. 6 / 10). Set these to match the move you actually trade so the meter's hit-rate is meaningful. Costs/P&amp;L are tracked by NT8, not here."/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Success target (ticks)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.PredictionTargetTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Success stop (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.PredictionStopTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min resolved samples (before scoring)"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.ReliabilityMinSamples, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Spoofing / layering"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Large add+cancel churn with almost nothing traded."/>
                        <CheckBox Content="Show in feed" Margin="0,2,0,2" IsChecked="{Binding Settings.ShowSpoofingSignals}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min add+cancel churn (contracts)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.SpoofMinChurn, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Max traded fraction (0–1)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.SpoofMaxTradedFraction, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Iceberg / absorption"/>
                        <TextBlock Style="{StaticResource Hint}" Text="More traded through a level than its displayed size dropped (hidden replenishment)."/>
                        <CheckBox Content="Show in feed" Margin="0,2,0,2" IsChecked="{Binding Settings.ShowIcebergSignals}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min hidden refill (contracts)"/>
                            <TextBox   Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.IcebergMinRefill, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Liquidity withdrawal"/>
                        <TextBlock Style="{StaticResource Hint}" Text="One-sided resting size pulled (not traded) near the touch."/>
                        <CheckBox Content="Show in feed" Margin="0,2,0,2" IsChecked="{Binding Settings.ShowWithdrawalSignals}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min pulled size (contracts)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.WithdrawalMinSize, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Radius from touch (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.WithdrawalRadiusTicks, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Aggression imbalance"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Aggressive buys lifting asks vs sells hitting bids."/>
                        <CheckBox Content="Show in feed" Margin="0,2,0,2" IsChecked="{Binding Settings.ShowAggressionSignals}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min aggressive volume (contracts)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.AggressionMinVolume, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min imbalance (0–1)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.AggressionMinImbalance, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Order-flow imbalance (OFI)"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Net signed queue pressure near the touch (Cont–Kukanov–Stoikov). The best-evidenced short-horizon predictor; watch its meter before trusting it."/>
                        <CheckBox Content="Show in feed" Margin="0,2,0,2" IsChecked="{Binding Settings.ShowOfiSignals}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min |OFI| (contracts)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.OfiMinImbalance, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Vicinity radius (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.OfiRadiusTicks, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Book imbalance (touch)"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Resting bid vs ask size at the touch: (Qbid − Qask)/(Qbid + Qask). A one-tick-ahead skew."/>
                        <CheckBox Content="Show in feed" Margin="0,2,0,2" IsChecked="{Binding Settings.ShowBookImbalanceSignals}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min ratio (0–1)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.BookImbalanceMinRatio, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Min total size (contracts)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.BookImbalanceMinSize, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Auto-Trade">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,10">
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,2" Text="Automatic trading on reliable signals (this instrument)"/>
                        <TextBlock Style="{StaticResource Hint}" Foreground="#FFFF8A80"
                                   Text="Places REAL orders automatically when an enabled type fires a green signal. Off by default. Validate on a Sim101 account first. One auto-position per instrument at a time; the host attaches an OCO target+stop on fill."/>

                        <CheckBox Content="AUTO-TRADE ARMED (master switch / kill switch)" Margin="0,6,0,4" FontWeight="Bold"
                                  IsChecked="{Binding Settings.AutoTradeArmed}"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="&quot;Green&quot; threshold (% hit-rate)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.ReliabilityGreenPercent, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Limit-entry timeout (seconds)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.AutoTradeEntryTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Max flow toxicity (0–1; 1 = off)"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4" Text="{Binding Settings.AutoTradeMaxToxicity, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Toxicity = one-sidedness of recent aggressive flow. Below 1, auto-entry stands aside when flow is that toxic (informed/one-sided = poor fills)."/>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Spoofing"/>
                        <CheckBox Content="Auto-trade this type" Margin="0,2" IsChecked="{Binding Settings.SpoofingAutoTrade.Enabled}"/>
                        <CheckBox Content="Market order (else limit at signal price + offset)" Margin="0,2" IsChecked="{Binding Settings.SpoofingAutoTrade.UseMarketOrder}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Entry offset (ticks)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Settings.SpoofingAutoTrade.OffsetTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Size (contracts)"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" Margin="0,4" Text="{Binding Settings.SpoofingAutoTrade.Size, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Target (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Settings.SpoofingAutoTrade.TargetTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Stop (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" Margin="0,4" Text="{Binding Settings.SpoofingAutoTrade.StopTicks, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Iceberg"/>
                        <CheckBox Content="Auto-trade this type" Margin="0,2" IsChecked="{Binding Settings.IcebergAutoTrade.Enabled}"/>
                        <CheckBox Content="Market order (else limit at signal price + offset)" Margin="0,2" IsChecked="{Binding Settings.IcebergAutoTrade.UseMarketOrder}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Entry offset (ticks)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Settings.IcebergAutoTrade.OffsetTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Size (contracts)"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" Margin="0,4" Text="{Binding Settings.IcebergAutoTrade.Size, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Target (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Settings.IcebergAutoTrade.TargetTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Stop (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" Margin="0,4" Text="{Binding Settings.IcebergAutoTrade.StopTicks, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Liquidity withdrawal"/>
                        <CheckBox Content="Auto-trade this type" Margin="0,2" IsChecked="{Binding Settings.WithdrawalAutoTrade.Enabled}"/>
                        <CheckBox Content="Market order (else limit at signal price + offset)" Margin="0,2" IsChecked="{Binding Settings.WithdrawalAutoTrade.UseMarketOrder}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Entry offset (ticks)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Settings.WithdrawalAutoTrade.OffsetTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Size (contracts)"/>
                            <TextBox   Grid.Row="0" Grid.Column="3" Margin="0,4" Text="{Binding Settings.WithdrawalAutoTrade.Size, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Target (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Settings.WithdrawalAutoTrade.TargetTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Stop (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" Margin="0,4" Text="{Binding Settings.WithdrawalAutoTrade.StopTicks, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Aggression imbalance"/>
                        <TextBlock Style="{StaticResource Hint}" Text="No price level → always enters at market; offset is ignored."/>
                        <CheckBox Content="Auto-trade this type" Margin="0,2" IsChecked="{Binding Settings.AggressionAutoTrade.Enabled}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Size (contracts)"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding Settings.AggressionAutoTrade.Size, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Target (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Settings.AggressionAutoTrade.TargetTicks, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Stop (ticks)"/>
                            <TextBox   Grid.Row="1" Grid.Column="3" Margin="0,4" Text="{Binding Settings.AggressionAutoTrade.StopTicks, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource DialogButton}" Content="Reset" Click="Reset_Click"/>
            <Button Style="{StaticResource DialogButton}" Content="Apply" Click="Apply_Click"/>
            <Button Style="{StaticResource DialogButton}" Content="Close" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
