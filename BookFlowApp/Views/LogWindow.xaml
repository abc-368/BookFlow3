<Window x:Class="BookFlow.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookFlow - Logs" Height="600" Width="800"
        Background="#FF2B3E50"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Button styles -->
        <Style x:Key="LogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="2" BorderBrush="#FF5BA0F2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5BA0F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FF34495E" Height="32">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                <Button Content="Clear" Style="{StaticResource LogButtonStyle}" 
                        Width="50" Margin="0,5,5,5" Click="ClearButton_Click"/>
                <Button Content="Save" Style="{StaticResource LogButtonStyle}" 
                        Width="50" Margin="0,5,5,5" Click="SaveButton_Click"/>
                <Separator Background="#FF4A90E2" Margin="5,8"/>
                <CheckBox x:Name="AutoScrollCheckBox" Content="Auto-scroll" 
                         IsChecked="True" Foreground="White" FontSize="10" 
                         VerticalAlignment="Center" Margin="10,0,5,0"/>
                <CheckBox x:Name="TimestampCheckBox" Content="Timestamp" 
                         IsChecked="True" Foreground="White" FontSize="10" 
                         VerticalAlignment="Center" Margin="10,0,5,0"/>
                <Separator Background="#FF4A90E2" Margin="5,8"/>
                <TextBlock Text="Buffer:" Foreground="White" FontSize="10" 
                          VerticalAlignment="Center" Margin="10,0,3,0"/>
                <TextBlock x:Name="BufferCountText" Text="{Binding BufferCount}" 
                          Foreground="#FF4A90E2" FontSize="10" FontWeight="Bold"
                          VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="lines" Foreground="White" FontSize="10" 
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Log Display (using TextBox for fast rendering like NT8TestClient) -->
        <Border Grid.Row="1" Background="#FF1A252F" BorderBrush="#FF4A90E2" 
                BorderThickness="1" Margin="5">
            <ScrollViewer x:Name="LogScrollViewer" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Auto"
                         Background="Transparent">
                <TextBox x:Name="LogTextBox" 
                        Text="{Binding LogText, Mode=OneWay}"
                        Background="Transparent" 
                        Foreground="White" 
                        BorderThickness="0"
                        FontFamily="Consolas" 
                        FontSize="10"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Hidden"
                        AcceptsReturn="True"
                        AcceptsTab="True"/>
            </ScrollViewer>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FF1E2A3A" BorderBrush="#FF4A90E2" 
                BorderThickness="0,1,0,0" Height="25" Padding="10,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Lines:" Foreground="White" FontSize="10" 
                              VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalLines}" Foreground="#FF4A90E2" 
                              FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    
                    <TextBlock Text="Rate:" Foreground="White" FontSize="10" 
                              VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding LogRate}" Foreground="#FF4A90E2" 
                              FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="logs/sec" Foreground="White" FontSize="9" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Grid.Column="1" Text="{Binding LastUpdateTime}" 
                          Foreground="#FF95A5A6" FontSize="9" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>