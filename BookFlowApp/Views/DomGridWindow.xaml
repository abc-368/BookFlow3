<Window x:Class="BookFlow.App.Views.DomGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:converters="clr-namespace:BookFlow.App.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="1600" Width="850"
        Background="#FF2B3E50"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Width">
    <Window.Resources>
        <!-- Import our converters -->
        <converters:NonZeroToVisibilityConverter x:Key="NonZeroToVisibilityConverter"/>
        <converters:VolumeProfileBarConverter x:Key="VolumeProfileBarConverter"/>
        <converters:OrderCellBackgroundConverter x:Key="OrderCellBackgroundConverter"/>
        <converters:TopOfBookBackgroundConverter x:Key="TopOfBookBackgroundConverter"/>
        <converters:PriceDisplayConverter x:Key="PriceDisplayConverter"/>
        <converters:DynamicPriceDisplayConverter x:Key="DynamicPriceDisplayConverter"/>
        <converters:VolumeDisplayConverter x:Key="VolumeDisplayConverter"/>
        <converters:PnLDisplayConverter x:Key="PnLDisplayConverter"/>
        <converters:PnLForegroundConverter x:Key="PnLForegroundConverter"/>
        <converters:VolumeProfileVisibilityConverter x:Key="VolumeProfileVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:GreaterThanZeroToBooleanConverter x:Key="GreaterThanZeroToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Added converter for bold binding -->
        <converters:BooleanToFontWeightConverter x:Key="BooleanToFontWeightConverter"/>
        
        <!-- Button style -->
        <Style x:Key="DomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="2" BorderBrush="#FF5BA0F2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5BA0F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF4A90E2" Offset="0"/>
                        <GradientStop Color="#FF2E5F8A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF5BA0F2" Offset="0"/>
                                <GradientStop Color="#FF3E6F9A" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ToggleButton style compatible with ToggleButton type -->
        <Style x:Key="SettingsToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF4A90E2" Offset="0"/>
                        <GradientStop Color="#FF2E5F8A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF5BA0F2" Offset="0"/>
                                            <GradientStop Color="#FF3E6F9A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF8A8A8A" Offset="0"/>
                                            <GradientStop Color="#FF6E6E6E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <converters:ColumnWidthConverter x:Key="ColumnWidthConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Settings Toolbar -->
        <Border Grid.Row="0" Background="#FF34495E" Height="32">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
                 <!-- Settings Button -->
                 <Button x:Name="SettingsButton" Width="28" Height="22" Margin="3,5,1,5" 
                         Style="{StaticResource SettingsButtonStyle}" Click="SettingsButton_Click">
                     <Canvas Width="12" Height="12">
                         <Rectangle Width="10" Height="2" Canvas.Left="1" Canvas.Top="2" Fill="White"/>
                         <Rectangle Width="10" Height="2" Canvas.Left="1" Canvas.Top="5" Fill="White"/>
                         <Rectangle Width="10" Height="2" Canvas.Left="1" Canvas.Top="8" Fill="White"/>
                     </Canvas>
                 </Button>
                 
                 <!-- Center Toggle: Unchecked => auto-center (Continuous); Checked => free float (None) -->
                 <ToggleButton x:Name="CenterButton" Width="28" Height="22" Margin="1,5"
                               Style="{StaticResource SettingsToggleButtonStyle}"
                               Checked="CenterToggle_Checked" Unchecked="CenterToggle_Unchecked"
                               MouseRightButtonDown="CenterButton_MouseRightButtonDown">
                     <Canvas Width="12" Height="12">
                         <Rectangle Width="10" Height="2" Canvas.Left="1" Canvas.Top="5" Fill="White"/>
                         <Rectangle Width="1" Height="4" Canvas.Left="1" Canvas.Top="4" Fill="White"/>
                         <Rectangle Width="1" Height="4" Canvas.Left="10" Canvas.Top="4" Fill="White"/>
                     </Canvas>
                 </ToggleButton>
                 
                 <!-- Clear Button -->
                 <Button x:Name="ClearButton" Width="28" Height="22" Margin="1,5"
                         Style="{StaticResource SettingsButtonStyle}" Click="ClearButton_Click">
                     <TextBlock Text="C" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                 </Button>

                 <!-- Order-flow signals feed toggle (shows/hides the docked panel beside the ladder) -->
                 <ToggleButton x:Name="SignalsButton" Width="28" Height="22" Margin="1,5"
                               Style="{StaticResource SettingsToggleButtonStyle}">
                     <TextBlock Text="&#931;" Foreground="White" FontSize="12" FontWeight="Bold"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                 </ToggleButton>
                </StackPanel>
                
                <!-- Right-aligned Settings Flyout Button -->
                <ToggleButton x:Name="QuickSettingsButton" Grid.Column="1" Width="28" Height="22" Margin="0,5,6,5"
                              Style="{StaticResource SettingsToggleButtonStyle}">
                    <TextBlock Text="S" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>

                <!-- Popup for quick settings -->
                <Popup Placement="Bottom" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=QuickSettingsButton}"
                       IsOpen="{Binding IsChecked, ElementName=QuickSettingsButton, Mode=TwoWay}">
                    <Border Background="#FF34495E" BorderBrush="#FF4A90E2" BorderThickness="1" CornerRadius="2" Padding="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Volume Profile Toggle -->
                            <CheckBox x:Name="VolumeProfileToggle" Content="Vol" Foreground="White" 
                                     VerticalAlignment="Center" Margin="0,0,8,0" FontSize="10"
                                     IsChecked="{Binding Settings.EnableVolumeProfiles}"/>

                            <!-- Logs Toggle -->
                            <CheckBox x:Name="LogsToggle" Content="Logs" Foreground="White" 
                                     VerticalAlignment="Center" Margin="0,0,12,0" FontSize="10"
                                     Checked="LogsToggle_Checked" Unchecked="LogsToggle_Unchecked"/>

                            <!-- Row Count Display -->
                            <TextBlock Text="Rows:" Foreground="White" FontSize="10" 
                                      VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBox x:Name="RowCountTextBox" Width="50" Height="18" FontSize="10" 
                                     Text="{Binding Settings.MaxVisibleRows, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#FF2B3E50" Foreground="White" BorderBrush="#FF4A90E2" Margin="0,0,12,0"/>

                            <!-- Font Size Control -->
                            <TextBlock Text="Font:" Foreground="White" FontSize="10" 
                                      VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBox x:Name="FontSizeTextBox" Width="30" Height="18" FontSize="10" 
                                     Text="{Binding Settings.FontSize, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#FF2B3E50" Foreground="White" BorderBrush="#FF4A90E2"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        
        <!-- Header with market info -->
        <Border Grid.Row="1" Background="#FF34495E" BorderBrush="#FF4A90E2" 
                BorderThickness="0,0,0,1" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding InstrumentName}" Foreground="White" 
                              FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" - High Performance DOM" Foreground="#FF95A5A6" 
                              FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Bid:" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <TextBlock Text="{Binding BestBidText}" Foreground="#FF4CAF50" FontSize="12" 
                              FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Ask:" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <TextBlock Text="{Binding BestAskText}" Foreground="#FFF44336" FontSize="12" 
                              FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Last:" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    <TextBlock Text="{Binding LastPriceText}" Foreground="#FF4A90E2" FontSize="12" 
                              FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="@" Foreground="#FF95A5A6" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastVolumeText}" Foreground="#FF4A90E2" FontSize="10" 
                              VerticalAlignment="Center" Margin="2,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- DOM Grid + adjacent persistent signals panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF1A252F" BorderBrush="#FF4A90E2"
                BorderThickness="1" Margin="0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Column headers -->
                <Border Grid.Row="0" Background="#FF34495E" BorderThickness="0,0,0,1" 
                        BorderBrush="#FF4A90E2">
                    <Grid Height="25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>  <!-- Observations -->
                            <ColumnDefinition Width="35"/>  <!-- Bid Orders Info -->
                            <ColumnDefinition Width="35"/>  <!-- Ask Orders Info -->
                            <ColumnDefinition Width="45"/>  <!-- Open Position P&L -->
                            <ColumnDefinition Width="50"/>  <!-- Volume Profile -->
                            <ColumnDefinition Width="70"/>  <!-- Price -->
                            <ColumnDefinition Width="50"/>  <!-- Bid Snapshot -->
                            <ColumnDefinition Width="50"/>  <!-- Bid Depth -->
                            <ColumnDefinition Width="40"/>  <!-- Last Trade at Bid -->
                            <ColumnDefinition Width="40"/>  <!-- Last Trade at Ask -->
                            <ColumnDefinition Width="50"/>  <!-- Ask Depth -->
                            <ColumnDefinition Width="50"/>  <!-- Ask Snapshot -->
                            <ColumnDefinition Width="45"/>  <!-- Ask Profile -->
                            <ColumnDefinition Width="45"/>  <!-- Bid Profile -->
                            <ColumnDefinition Width="30"/>  <!-- Reserve -->
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Obs" Foreground="White" FontSize="8" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Bid Ord" Foreground="White" FontSize="8" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Ask Ord" Foreground="White" FontSize="8" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="P&amp;L" Foreground="White" FontSize="8" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="Vol Prof" Foreground="White" FontSize="7" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="Price" Foreground="White" FontSize="9" 
                                  FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="Bid Snap" Foreground="White" FontSize="7" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="Bid Dep" Foreground="White" FontSize="7" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="LTB" Foreground="White" FontSize="8" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Text="LTA" Foreground="White" FontSize="8" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="10" Text="Ask Dep" Foreground="White" FontSize="7" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="11" Text="Ask Snap" Foreground="White" FontSize="7" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="12" Text="Ask Prof" Foreground="White" FontSize="7" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="13" Text="Bid Prof" Foreground="White" FontSize="7" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="14" Text="Rsrv" Foreground="White" FontSize="8" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <!-- DevExpress DOM Grid -->
                <dxg:GridControl Grid.Row="1" x:Name="DomGridControl" ItemsSource="{Binding DomRows}" AutoGenerateColumns="None"
                                 Background="#FF1E2A3A" Foreground="White"
                                 BorderBrush="#FF34495E" BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="DomTableView" 
                                      ShowGroupPanel="False" 
                                      ShowSearchPanelMode="Never"
                                      ShowFilterPanelMode="Never" 
                                      ShowColumnHeaders="False"
                                      ShowIndicator="False"
                                      AllowColumnMoving="False"
                                      AllowSorting="False"
                                      AllowGrouping="False"
                                      AllowColumnFiltering="False"
                                      AllowBestFit="True"
                                      AllowEditing="False"
                                      NavigationStyle="None"
                                      VerticalScrollbarVisibility="Hidden"
                                      HorizontalScrollbarVisibility="Hidden"
                                      ShowVerticalLines="False"
                                      ShowHorizontalLines="False"
                                      EnableImmediatePosting="True"
                                      AllowCascadeUpdate="False"
                                      IsSynchronizedWithCurrentItem="False"
                                      AllowScrollAnimation="False"
                                      AllowPerPixelScrolling="True"
                                      ShowFocusedRectangle="False"
                                      RowIndicatorContentTemplate="{x:Null}">
                            <dxg:TableView.RowStyle>
                                <Style TargetType="{x:Type dxg:RowControl}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Height" Value="18"/>
                                </Style>
                            </dxg:TableView.RowStyle>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                    <dxg:GridControl.Columns>
                        
                        <!-- 1. Observations Column -->
                        <dxg:GridColumn x:Name="ObservationsColumn" FieldName="Observations" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[Observations].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Microstructure glyph: S=spoof, I=iceberg (transient, set by the VM). -->
                                    <Border Background="#FF1A252F">
                                        <TextBlock Text="{Binding RowData.Row.SignalGlyph}"
                                                  Foreground="#FFFFC107" FontSize="9" FontWeight="Bold"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 2. Bid Orders Info Column -->
                        <dxg:GridColumn x:Name="BidOrdersColumn" FieldName="DisplayBidOrderCount" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[BidOrders].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Background>
                                            <Binding Path="RowData.Row.DisplayBidOrderCount" Converter="{StaticResource OrderCellBackgroundConverter}" ConverterParameter="bid"/>
                                        </Border.Background>
                                         <TextBlock FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">
                                             <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:+0;-0;}">
                                                    <Binding Path="RowData.Row.DisplayBidOrderCount"/>
                                                </MultiBinding>
                                             </TextBlock.Text>
                                             <TextBlock.Visibility>
                                                <Binding Path="RowData.Row.DisplayBidOrderCount" Converter="{StaticResource NonZeroToVisibilityConverter}"/>
                                             </TextBlock.Visibility>
                                         </TextBlock>
                                     </Border>
                                 </DataTemplate>
                             </dxg:GridColumn.CellTemplate>
                         </dxg:GridColumn>

                         <!-- 3. Ask Orders Info Column -->
                         <dxg:GridColumn x:Name="AskOrdersColumn" FieldName="DisplayAskOrderCount" Header="" AllowResizing="False"
                                         Width="{Binding DataContext.Settings.ColumnsByKey[AskOrders].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Background>
                                            <Binding Path="RowData.Row.DisplayAskOrderCount" Converter="{StaticResource OrderCellBackgroundConverter}" ConverterParameter="ask"/>
                                        </Border.Background>
                                         <TextBlock FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White">
                                             <TextBlock.Text>
                                                <MultiBinding ConverterParameter="ask" StringFormat="{}-{0:#}">
                                                    <Binding Path="RowData.Row.DisplayAskOrderCount"/>
                                                </MultiBinding>
                                             </TextBlock.Text>
                                             <TextBlock.Visibility>
                                                <Binding Path="RowData.Row.DisplayAskOrderCount" Converter="{StaticResource NonZeroToVisibilityConverter}"/>
                                             </TextBlock.Visibility>
                                         </TextBlock>
                                     </Border>
                                 </DataTemplate>
                             </dxg:GridColumn.CellTemplate>
                         </dxg:GridColumn>

                        <!-- 4. Open Position P&L Column -->
                        <dxg:GridColumn x:Name="OpenPositionPnLColumn" FieldName="OpenPositionPnL" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[OpenPositionPnL].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1A252F">
                                        <TextBlock 
                                            Text="{Binding RowData.Row.OpenPositionPnL, Converter={StaticResource PnLDisplayConverter}}"
                                            Foreground="{Binding RowData.Row.OpenPositionPnL, Converter={StaticResource PnLForegroundConverter}}"
                                            FontSize="8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 5. Volume Profile Column -->
                        <dxg:GridColumn x:Name="VolumeProfileColumn" FieldName="VolumeProfile" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[VolumeProfile].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1A252F">
                                        <Grid>
                                            <Border Background="#FFB0BEC5" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource VolumeProfileBarConverter}">
                                                        <Binding Path="RowData.Row.VolumeProfile"/>
                                                        <Binding Path="DataContext.MaxVolumeProfile" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource VolumeProfileVisibilityConverter}">
                                                        <Binding Path="DataContext.Settings.ShowVolumeProfileColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Settings.EnableVolumeProfiles" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Visibility>
                                            </Border>
                                            <TextBlock Text="{Binding RowData.Row.VolumeProfile, Converter={StaticResource VolumeDisplayConverter}}" 
                                                      Foreground="White" FontSize="8"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 6. Price Ladder Column (CENTER COLUMN) -->
                        <dxg:GridColumn x:Name="PriceColumn" FieldName="Price" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[Price].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Q2 zone tint (bid/ask background) + Q1 last-hit accent (left border) -->
                                    <Border BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FF2B3E50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RowData.Row.IsBidZone}" Value="True">
                                                        <Setter Property="Background" Value="#1A4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RowData.Row.IsAskZone}" Value="True">
                                                        <Setter Property="Background" Value="#1AF44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RowData.Row.IsLastBidHit}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RowData.Row.IsLastAskHit}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FFF44336"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Foreground="White"
                                                  FontWeight="{Binding DataContext.Settings.ColumnsByKey[Price].IsBold, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToFontWeightConverter}}"
                                                  FontSize="9"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource DynamicPriceDisplayConverter}">
                                                    <Binding Path="RowData.Row.Price"/>
                                                    <Binding Path="DataContext.PriceDecimalPlaces" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 7. Bid Snapshot Column (OUTER - delta/changes) -->
                        <dxg:GridColumn x:Name="BidSnapshotColumn" FieldName="BidSnapshot" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[BidSnapshot].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FF3498DB">
                                        <TextBlock Text="{Binding RowData.Row.DisplayBidSnapshot, Converter={StaticResource VolumeDisplayConverter}}"
                                                  Foreground="White" FontSize="8"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 8. Bid Depth Column (INNER - L2 depth) -->
                        <dxg:GridColumn x:Name="BidDepthColumn" FieldName="BidDepth" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[BidDepth].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" 
                                            PreviewMouseLeftButtonDown="Depth_PreviewMouseLeftButtonDown"
                                            MouseLeftButtonDown="BidDepth_MouseLeftButtonDown" 
                                            MouseRightButtonDown="BidDepth_MouseRightButtonDown">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource TopOfBookBackgroundConverter}" ConverterParameter="bid">
                                                <Binding Path="RowData.Row.IsTopBid"/>
                                                <Binding Path="RowData.Row.IsTopAsk"/>
                                                <Binding Path="RowData.Row.DisplayBidDepth"/>
                                                <Binding Path="RowData.Row.LastBidHitTicks"/>
                                                <Binding Path="RowData.Row.LastAskHitTicks"/>
                                                <Binding Path="DataContext.UiPulseTicks" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Border.Background>
                                        <Grid>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource VolumeProfileBarConverter}">
                                                        <Binding Path="RowData.Row.DisplayBidDepth"/>
                                                        <Binding Source="500"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource TopOfBookBackgroundConverter}" ConverterParameter="bid-profile">
                                                        <Binding Path="RowData.Row.IsTopBid"/>
                                                        <Binding Path="RowData.Row.IsTopAsk"/>
                                                        <Binding Path="RowData.Row.DisplayBidDepth"/>
                                                        <Binding Path="RowData.Row.LastBidHitTicks"/>
                                                        <Binding Path="RowData.Row.LastAskHitTicks"/>
                                                        <Binding Path="DataContext.UiPulseTicks" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding RowData.Row.DisplayBidDepth, Converter={StaticResource VolumeDisplayConverter}}"
                                                       Foreground="White" FontSize="8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 9. Last Trade at Bid Column -->
                        <dxg:GridColumn x:Name="LastTradeAtBidColumn" FieldName="LastTradeAtBidBurst" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[LastTradeAtBid].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1A252F">
                                        <TextBlock Text="{Binding RowData.Row.LastTradeAtBidBurst, Converter={StaticResource VolumeDisplayConverter}}" 
                                                  Foreground="White" FontSize="8"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 10. Last Trade at Ask Column -->
                        <dxg:GridColumn x:Name="LastTradeAtAskColumn" FieldName="LastTradeAtAskBurst" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[LastTradeAtAsk].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1A252F">
                                        <TextBlock Text="{Binding RowData.Row.LastTradeAtAskBurst, Converter={StaticResource VolumeDisplayConverter}}" 
                                                  Foreground="White" FontSize="8"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 11. Ask Depth Column (INNER - L2 depth values closest to price) -->
                        <dxg:GridColumn x:Name="AskDepthColumn" FieldName="AskDepth" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[AskDepth].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" 
                                            PreviewMouseLeftButtonDown="Depth_PreviewMouseLeftButtonDown"
                                            MouseLeftButtonDown="AskDepth_MouseLeftButtonDown" 
                                            MouseRightButtonDown="AskDepth_MouseRightButtonDown">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource TopOfBookBackgroundConverter}" ConverterParameter="ask">
                                                <Binding Path="RowData.Row.IsTopBid"/>
                                                <Binding Path="RowData.Row.IsTopAsk"/>
                                                <Binding Path="RowData.Row.DisplayAskDepth"/>
                                                <Binding Path="RowData.Row.LastBidHitTicks"/>
                                                <Binding Path="RowData.Row.LastAskHitTicks"/>
                                                <Binding Path="DataContext.UiPulseTicks" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Border.Background>
                                        <Grid>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource VolumeProfileBarConverter}">
                                                        <Binding Path="RowData.Row.DisplayAskDepth"/>
                                                        <Binding Source="500"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource TopOfBookBackgroundConverter}" ConverterParameter="ask-profile">
                                                        <Binding Path="RowData.Row.IsTopBid"/>
                                                        <Binding Path="RowData.Row.IsTopAsk"/>
                                                        <Binding Path="RowData.Row.DisplayAskDepth"/>
                                                        <Binding Path="RowData.Row.LastBidHitTicks"/>
                                                        <Binding Path="RowData.Row.LastAskHitTicks"/>
                                                        <Binding Path="DataContext.UiPulseTicks" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding RowData.Row.DisplayAskDepth, Converter={StaticResource VolumeDisplayConverter}}"
                                                      Foreground="White" FontSize="8"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 12. Ask Snapshot Column (OUTER - delta/changes) -->
                        <dxg:GridColumn x:Name="AskSnapshotColumn" FieldName="AskSnapshot" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[AskSnapshot].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FFE74C3C">
                                        <TextBlock Text="{Binding RowData.Row.DisplayAskSnapshot, Converter={StaticResource VolumeDisplayConverter}}"
                                                  Foreground="White" FontSize="8"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 13. Ask Profile Column -->
                        <dxg:GridColumn x:Name="AskProfileColumn" FieldName="AskProfile" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[AskProfile].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1A252F">
                                        <Grid>
                                            <Border Background="#FFE74C3C" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource VolumeProfileBarConverter}">
                                                        <Binding Path="RowData.Row.AskProfile"/>
                                                        <Binding Path="DataContext.MaxAskProfile" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource VolumeProfileVisibilityConverter}">
                                                        <Binding Path="DataContext.Settings.ShowAskProfileColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Settings.EnableVolumeProfiles" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Visibility>
                                            </Border>
                                            <TextBlock Text="{Binding RowData.Row.AskProfile, Converter={StaticResource VolumeDisplayConverter}}" 
                                                      Foreground="White" FontSize="8"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 14. Bid Profile Column -->
                        <dxg:GridColumn x:Name="BidProfileColumn" FieldName="BidProfile" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[BidProfile].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1A252F">
                                        <Grid>
                                            <Border Background="#FF3498DB" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource VolumeProfileBarConverter}">
                                                        <Binding Path="RowData.Row.BidProfile"/>
                                                        <Binding Path="DataContext.MaxBidProfile" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource VolumeProfileVisibilityConverter}">
                                                        <Binding Path="DataContext.Settings.ShowBidProfileColumn" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        <Binding Path="DataContext.Settings.EnableVolumeProfiles" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </Border.Visibility>
                                            </Border>
                                            <TextBlock Text="{Binding RowData.Row.BidProfile, Converter={StaticResource VolumeDisplayConverter}}" 
                                                      Foreground="White" FontSize="8"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- 15. Reserve Column -->
                        <dxg:GridColumn x:Name="ReserveColumn" FieldName="Reserve" Header="" AllowResizing="False"
                                        Width="{Binding DataContext.Settings.ColumnsByKey[Reserve].Width, RelativeSource={RelativeSource AncestorType=Window}}">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1A252F">
                                        <TextBlock Text="{Binding RowData.Row.Reserve}" 
                                                  Foreground="White" FontSize="8"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                </dxg:GridControl>
            </Grid>
        </Border>

        <!-- Persistent order-flow signals panel, docked beside the ladder (toggled by the Sigma button) -->
        <Border Grid.Column="1" x:Name="SignalsPanel" Width="320" Margin="2,0,0,0"
                VerticalAlignment="Stretch"
                Background="#FF1E2A3A" BorderBrush="#FF4A90E2" BorderThickness="1"
                Visibility="{Binding IsChecked, ElementName=SignalsButton, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="Order-Flow Signals" Foreground="White" FontWeight="Bold" FontSize="11" Margin="2,0,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecentSignals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#FF95A5A6" FontSize="9" VerticalAlignment="Center"/>
                                    <!-- Predicted-direction arrow; bold when the signal is strong. -->
                                    <TextBlock Grid.Column="1" Text="{Binding DirectionArrow}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{Binding ArrowColorHex, Converter={StaticResource HexToBrushConverter}}"
                                               FontWeight="{Binding IsStrong, Converter={StaticResource BooleanToFontWeightConverter}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="9" VerticalAlignment="Center" Margin="3,0,0,0"
                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                               FontWeight="{Binding IsStrong, Converter={StaticResource BooleanToFontWeightConverter}}"/>
                                    <!-- Prediction-power meter (type hit-rate known at print time); tooltip has the rate + sample count. -->
                                    <TextBlock Grid.Column="3" Text="{Binding StrengthMeter}" FontFamily="Consolas" FontSize="9"
                                               VerticalAlignment="Center" Margin="6,0,2,0" ToolTip="{Binding StrengthTooltip}"
                                               Foreground="{Binding StrengthColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#FF1E2A3A" BorderBrush="#FF4A90E2" 
                BorderThickness="0,1,0,0" Height="30" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Position:" Foreground="White" FontSize="10" 
                              VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PositionText}" Foreground="#FF4A90E2" 
                              FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    
                    <TextBlock Text="P&amp;L:" Foreground="White" FontSize="10" 
                              VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding PnLText}" FontSize="12" FontWeight="Bold" 
                              VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#FF4A90E2"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Spread:" Foreground="White" FontSize="10" 
                              VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding SpreadText}" Foreground="#FFFF9800" 
                              FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Center" Style="{StaticResource DomButtonStyle}" 
                            Width="50" Margin="0,0,5,0" Click="BottomCenterButton_Click"/>
                    <Button Content="Cancel All" Style="{StaticResource DomButtonStyle}" 
                            Width="60" Margin="0,0,5,0" Command="{Binding CancelAllOrdersCommand}"/>
                    <Button Content="Flatten" Style="{StaticResource DomButtonStyle}" 
                            Width="50" Command="{Binding FlattenCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>