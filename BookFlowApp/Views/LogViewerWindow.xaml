<Window x:Class="BookFlow.App.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookFlow - System Log" Width="700" Height="600"
        Background="#FF1E2A3A"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="LogButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF4A90E2" Offset="0"/>
                        <GradientStop Color="#FF2E5F8A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                BorderBrush="#FF5BA0F2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF5BA0F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF2B3E50" BorderBrush="#FF4A90E2" BorderThickness="1" CornerRadius="5" Margin="8" Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3,0,0,6">
                <TextBlock Text="System Log" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <CheckBox Name="chkAutoScroll" Content="Auto Scroll" Foreground="White"
                          FontSize="11" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True"/>
                <Button Content="Copy" Style="{StaticResource LogButtonStyle}" Width="70" Margin="20,0,0,0" Click="CopyLog_Click"/>
                <Button Content="Select All" Style="{StaticResource LogButtonStyle}" Width="80" Margin="8,0,0,0" Click="SelectAllLog_Click"/>
                <Button Content="Clear Log" Style="{StaticResource LogButtonStyle}" Width="80" Margin="8,0,0,0" Click="BtnClearLog_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox Name="txtSystemLog"
                         Text="{Binding SystemLogText, Mode=OneWay}"
                         TextChanged="TxtSystemLog_TextChanged"
                         TextWrapping="Wrap"
                         Background="#FF1A252F" Foreground="#FFEEEEEE"
                         FontFamily="Consolas" FontSize="11" Padding="5"
                         BorderThickness="0"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Hidden"
                         HorizontalScrollBarVisibility="Hidden">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Click="CopyLog_Click" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Select All" Click="SelectAllLog_Click" InputGestureText="Ctrl+A"/>
                            <Separator/>
                            <MenuItem Header="Clear Log" Click="BtnClearLog_Click"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
